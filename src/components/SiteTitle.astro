---
import logo from '../assets/header_logo.svg?raw';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <span class="logo" aria-hidden="true" set:html={logo} />
  <span class="title" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    min-width: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo {
    flex-shrink: 0;
    width: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo :global(.sub) {
    fill: var(--aquapack-red);
  }

  .title {
    overflow: hidden;
  }
</style>
